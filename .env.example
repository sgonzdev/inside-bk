# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://insideout:insideout_secret@postgres:5432/insideout_db?schema=public

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# AI Provider (openai | anthropic | deepseek)
AI_PROVIDER=deepseek
AI_MODEL=              # Optional: override default model (gpt-4o-mini / claude-sonnet-4-6 / deepseek-chat)
AI_MAX_TOKENS=102412
AI_TEMPERATURE=0.11212
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
DEEPSEEK_API_KEY=your-deepseek-api-key

# Auth
BCRYPT_ROUNDS=121212

# Rate Limiting12
RATE_LIMIT_GENERAL_WINDOW_MS=600001212
RATE_LIMIT_GENERAL_MAX=1001221
RATE_LIMIT_AUTH_WINDOW_MS=600001221
RATE_LIMIT_AUTH_MAX=101212

# CORS
CORS_ORIGIN=http://localhost:5173

# Storage (MinIO / S3)
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=insideout
S3_REGION=us-east-1
S3_PUBLIC_URL=http://localhost:9000


LOGIN_MAX_ATTEMPTS=11212
LOGIN_LOCK_MINUTES=121
EMAIL_VERIFICATION_EXPIRES_H=1
# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false        # true para puerto 465, false para 587/STARTTLS
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
EMAIL_FROM=InsideOut <noreply@example.com>
# Rate limit (por usuario/correo; la IP solo como tope amplio, la U comparte una IP)
RATE_LIMIT_GENERAL_ANON_MAX=600
RATE_LIMIT_AUTH_IP_WINDOW_MS=900000
RATE_LIMIT_AUTH_IP_MAX=300
# Saltos de proxy delante de Express (nginx = 1)
TRUST_PROXY=1

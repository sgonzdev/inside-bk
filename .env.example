# ─────────────────────────────────────────────────────────────
# InsideOut Expressions — variables de entorno del backend
# Los valores mostrados son los por defecto del código
# (src/shared/config/env.ts). Las marcadas (requerida) no tienen
# valor por defecto: sin ellas el servidor no arranca.
# ─────────────────────────────────────────────────────────────

# Server
PORT=3000
NODE_ENV=development
# URL pública de esta API
APP_URL=http://localhost:3000
# URL pública del front (se usa en los enlaces de los correos)
FRONTEND_URL=http://localhost:5173

# Database (requerida)
DATABASE_URL=postgresql://insideout:insideout_secret@postgres:5432/insideout_db?schema=public

# JWT (requeridas, mínimo 10 caracteres; usar valores largos y aleatorios)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# AI Provider (openai | anthropic | deepseek)
AI_PROVIDER=deepseek
# Opcional: modelo distinto al por defecto del proveedor
AI_MODEL=
AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.7
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
DEEPSEEK_API_KEY=your-deepseek-api-key

# Auth
# 12 tarda ~250 ms por contraseña. NO subir mucho: cada +1 duplica el tiempo
BCRYPT_ROUNDS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Horas que dura el enlace de verificación de correo
EMAIL_VERIFICATION_EXPIRES_H=24
# Minutos que dura el enlace de restablecer contraseña
PASSWORD_RESET_EXPIRES_MIN=15

# CORS (URL del front)
CORS_ORIGIN=http://localhost:5173

# Redis (rate limit)
REDIS_URL=redis://redis:6379

# Rate limit
# Por usuario con sesión, cada ventana
RATE_LIMIT_GENERAL_WINDOW_MS=60000
RATE_LIMIT_GENERAL_MAX=100
# Sin sesión, por IP. Alto porque la universidad sale por una sola IP pública
RATE_LIMIT_GENERAL_ANON_MAX=600
# Login/registro/recuperar contraseña, por correo
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=10
# Tope de intentos de auth por IP (15 min). Subirlo para jornadas de registro masivo
RATE_LIMIT_AUTH_IP_WINDOW_MS=900000
RATE_LIMIT_AUTH_IP_MAX=300
# Saltos de proxy delante de Express (nginx = 1). Requiere que nginx envíe
# X-Forwarded-For ($proxy_add_x_forwarded_for)
TRUST_PROXY=1

# Storage (MinIO / S3) (endpoint, keys y public URL requeridas)
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=insideout
S3_REGION=us-east-1
S3_PUBLIC_URL=http://localhost:9000

# SMTP (host, user y password requeridas)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# true para puerto 465, false para 587/STARTTLS
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
EMAIL_FROM=InsideOut <noreply@example.com>

# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://insideout:insideout_secret@postgres:5432/insideout_db?schema=public

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# AI Provider (openai | anthropic | deepseek)
AI_PROVIDER=deepseek
AI_MODEL=              # Optional: override default model (gpt-4o-mini / claude-sonnet-4-6 / deepseek-chat)
AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.7
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
DEEPSEEK_API_KEY=your-deepseek-api-key

# Auth
BCRYPT_ROUNDS=12

# Rate Limiting
RATE_LIMIT_GENERAL_WINDOW_MS=60000
RATE_LIMIT_GENERAL_MAX=100
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=10

# CORS
CORS_ORIGIN=http://localhost:5173

# Storage (MinIO / S3)
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=insideout
S3_REGION=us-east-1
S3_PUBLIC_URL=http://localhost:9000

model Emotion {
  id       String @id @default(uuid())
  name     String @unique
  parentId String? @map("parent_id")
  color    String?

  parent   Emotion?  @relation("EmotionHierarchy", fields: [parentId], references: [id])
  children Emotion[] @relation("EmotionHierarchy")
  logs     EmotionLog[]

  @@map("emotions")
}

model EmotionLog {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  emotionId  String   @map("emotion_id")
  intensity  Int      @default(5)
  note       String?
  aiFeedback String?  @map("ai_feedback")
  createdAt  DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  emotion Emotion @relation(fields: [emotionId], references: [id])

  @@index([userId])
  @@map("emotion_logs")
}

model Emotion {
  id    String  @id @default(uuid())
  name  String  @unique
  color String?

  logs EmotionLog[]

  @@map("emotions")
}

model EmotionLog {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  emotionId  String   @map("emotion_id")
  aiFeedback String?  @map("ai_feedback")
  createdAt  DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  emotion Emotion @relation(fields: [emotionId], references: [id])

  @@index([userId])
  @@map("emotion_logs")
}

model EmotionalPrediction {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  prediction String
  date       DateTime @map("date") // midnight of the day

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("emotional_predictions")
}
